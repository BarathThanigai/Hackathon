# Choose the active provider at startup: nvidia (API key) or ollama (local).
# If nvidia is selected but MEMORYMAP_AI_API_KEY is empty, MemoryMap
# automatically falls back to Ollama.
MEMORYMAP_AI_PROVIDER=nvidia

# API-key / OpenAI-compatible NVIDIA NIM provider
MEMORYMAP_AI_API_KEY=replace-with-your-key
MEMORYMAP_AI_BASE_URL=https://integrate.api.nvidia.com/v1
MEMORYMAP_AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
MEMORYMAP_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Local Ollama provider. Install models with:
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
MEMORYMAP_OLLAMA_BASE_URL=http://127.0.0.1:11434
MEMORYMAP_OLLAMA_MODEL=llama3.2
MEMORYMAP_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Local CPU inference can be slower than a hosted API. The UI will show live
# ingestion checkpoints while the model is working.
MEMORYMAP_OLLAMA_TIMEOUT_SECONDS=600
MEMORYMAP_AI_TIMEOUT_SECONDS=600

# Keep RAG responsive if the optional Aura graph is unreachable.
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
